# the key of the voice service. left empty, the voice is silence of the length the text would take
OPENAI_API_KEY=

# the voice provider: auto, silent, speech or realtime
SHORT_VOICE=auto

# the size of the render: draft (540 by 960, 15 frames a second) or final (1080 by 1920, 30 frames a second)
SHORT_QUALITY=draft

# the language of a scene rendered on its own: ru or en
SHORT_LANG=ru

# the ffmpeg built with libass, and its ffprobe
SHORT_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
SHORT_FFPROBE=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
