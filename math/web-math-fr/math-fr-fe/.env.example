# the backend. empty runs the site on its own, from the content snapshot, with accounts, saved
# parameter sets and the deep zoom off
VITE_API_BASE=http://localhost:1585/api
# the wordmark in the bar and the page title
VITE_BRAND=M / Math
# where the donate button leads; empty shows no button
VITE_DONATE_URL=
# the colour palette of the kit case that has several: T_GD (gold), T_WP (warm peach), T_AG (apricot and
# green), T_GP (green peach); unset is T_GD. in development a select in the bar tries them without a restart
VITE_KIT_PALETTE=
