{
  "name": "math-fr-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "build:pages": "VITE_API_BASE= VITE_BASE=/web-3d-explore/ vite build && cp dist/index.html dist/404.html",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:maths": "node --experimental-strip-types scripts/check-maths.ts",
    "check:chaos": "node --experimental-strip-types scripts/check-chaos.ts",
    "check:net": "node --experimental-strip-types scripts/check-net.ts",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "snapshot": "cd ../math-fr-be && uv run python -m app.content.export ../math-fr-fe/src/content/snapshot",
    "theme:ship": "node --experimental-strip-types scripts/theme-ship.ts",
    "storybook": "npm --prefix ../ui-kit run storybook",
    "storybook:build": "npm --prefix ../ui-kit run storybook:build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.36",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
