{
  "name": "@kseni/ui-kit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "theme": "node --experimental-strip-types build/theme.ts",
    "storybook": "storybook dev -p 1222 --no-open --ci",
    "storybook:build": "storybook build",
    "theme:watch": "node --experimental-strip-types --watch build/theme.ts",
    "package": "node --experimental-strip-types build/package.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "description": "The component kit and its theme, built from the base case.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css",
    "./registry.css": "./dist/registry.css"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "radix-ui": "^1.6",
    "cn": "^0.4",
    "class-variance-authority": "^0.7",
    "lucide-react": ">=1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4",
    "@fontsource-variable/geist": "^5",
    "@fontsource-variable/geist-mono": "^5"
  }
}
